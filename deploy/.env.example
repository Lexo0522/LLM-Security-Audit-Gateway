# Copy to deploy/.env (git-ignored) to override build-time mirrors and service
# passwords. When invoking compose from the repo root, pass
# `--env-file deploy/.env` explicitly; from inside deploy/ it is picked up
# automatically.

# Build-time mirrors. Defaults already point at China-friendly mirrors; switch
# back to the official ones if your build host can reach them directly.
#DOCKER_BUILD_GOPROXY=https://goproxy.cn,direct
#DOCKER_NPM_REGISTRY=https://registry.npmmirror.com

# Service passwords. The compose defaults (change-me) are development-only and
# must never reach a shared or production host.
#POSTGRES_PASSWORD=replace-with-a-long-random-password
#CLICKHOUSE_PASSWORD=replace-with-a-long-random-password
