FROM golang:1.24-alpine AS build
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=$GOPROXY
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/gateway ./cmd/gateway
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/audit-consumer ./cmd/audit-consumer

FROM alpine:3.21
RUN adduser -D -H gateway
USER gateway
COPY --from=build /out/gateway /gateway
COPY --from=build /out/audit-consumer /audit-consumer
EXPOSE 8080
EXPOSE 9090
ENTRYPOINT ["/gateway"]
